APP_ENV=development
APP_URL=http://localhost:8000

# Connection settings for the MySQL 8 database created by backend/database/schema.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tnc_store
DB_USERNAME=root
DB_PASSWORD=
# Optional TLS: path (absolute, or relative to backend/config) to a CA bundle.
# Leave empty to connect without TLS.
DB_SSL_CA=
DB_SSL_VERIFY=true